{
    "name": "edu-slicer",
    "version": "4.7.0",
    "description": "3D-друк: шкільний слайсер EduProstir на основі Kiri:Moto (grid.space)",
    "author": "Stewart Allen <sa@grid.space>",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/zavada123/edu-slicer.git"
    },
    "keywords": [
        "grid.space",
        "mesh:tool",
        "kiri:moto",
        "kirimoto",
        "kiri",
        "mesh",
        "editor",
        "3D",
        "FDM",
        "CAM",
        "CNC",
        "mSLA",
        "laser",
        "waterjet",
        "wire edm",
        "wire-edm",
        "dragknife",
        "drag knife",
        "gcode",
        "slicer"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.1.1",
        "@gridspace/raster-path": "^1.1.1",
        "@tracespace/parser": "^5.0.0-next.0",
        "@tweenjs/tween.js": "^16.6.0",
        "base64-js": "^1.5.1",
        "earcut": "^3.0.1",
        "jszip": "^3.7.1",
        "manifold-3d": "^3.3.2",
        "quickjs-emscripten": "^0.20.0",
        "three": "^0.182.0",
        "three-mesh-bvh": "^0.7.6"
    },
    "devDependencies": {
        "esbuild": "^0.25.5",
        "fast-glob": "^3.3.3",
        "webpack": "^5.92.1",
        "webpack-cli": "^5.1.4"
    },
    "scripts": {
        "build": "npm run webpack-three && npm run webpack-zip && npm run webpack-qjs && node bin/esbuild.config.mjs prod --kiri && node tools/build-static.mjs",
        "test": "node --test test/*.test.mjs",
        "uk": "python3 -I tools/make_uk.py",
        "webpack-qjs": "webpack --config bin/webpack-quickjs-esm.js",
        "webpack-three": "webpack --config bin/webpack-three-esm.js",
        "webpack-zip": "webpack --config bin/webpack-jszip-esm.js"
    },
    "sideEffects": true
}
